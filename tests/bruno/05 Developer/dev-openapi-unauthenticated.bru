meta {
  name: Dev OpenAPI Unauthenticated Blocked
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/wp-json/ai-ready-wp-dev/v1/openapi
  body: none
  auth: none
}

assert {
  res.status: eq 403
  res.body.code: eq rest_forbidden
}

tests {
  test("returns 403 Forbidden when unauthenticated", function() {
    expect(res.getStatus()).to.equal(403);
    const body = res.getBody();
    expect(body.code).to.equal('rest_forbidden');
  });
}
