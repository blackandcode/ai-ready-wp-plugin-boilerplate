{
  "name": "ai-ready-wp-plugin-boilerplate",
  "version": "1.0.1",
  "description": "Enterprise-grade WordPress plugin boilerplate designed for AI coding agents and human developers.",
  "private": true,
  "engines": {
    "node": ">=24.16.0",
    "npm": ">=11"
  },
  "scripts": {
    "pre-check": "node tools/environment/check-environment.mjs",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:destroy": "wp-env destroy",
    "env:clean": "wp-env clean all",
    "env:reset": "wp-env reset all",
    "env:logs": "wp-env logs",
    "env:cli": "wp-env run cli bash",
    "wp:setup": "node tools/wp-env/after-start.mjs",
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:md",
    "lint:js": "wp-scripts lint-js src/frontend",
    "lint:css": "wp-scripts lint-style 'src/frontend/**/*.css'",
    "lint:md": "markdownlint-cli2 'docs/**/*.md' 'README.md' 'AGENTS.md'",
    "test": "npm run test:unit && npm run test:scaffold && npm run test:versioning && npm run test:environment",
    "test:unit": "wp-scripts test-unit-js --config=jest.config.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:rest": "node tools/rest-tests/run-rest-tests.mjs",
    "test:rest:html": "node tools/rest-tests/run-rest-tests.mjs --html",
    "scaffold": "node tools/scaffolding/scaffold-plugin.mjs",
    "rename": "node tools/scaffolding/scaffold-plugin.mjs",
    "test:scaffold": "node --test tests/node/scaffolding/*.test.mjs",
    "skills:sync": "node tools/agent-skills/sync-agent-skills.mjs",
    "update-version": "node tools/versioning/increase-plugin-version.mjs",
    "update-version:dry-run": "node tools/versioning/increase-plugin-version.mjs --dry-run",
    "update-version:patch": "node tools/versioning/increase-plugin-version.mjs --bump patch",
    "update-version:minor": "node tools/versioning/increase-plugin-version.mjs --bump minor",
    "update-version:major": "node tools/versioning/increase-plugin-version.mjs --bump major",
    "changelog:add": "node tools/changelog/record-unreleased-change.mjs",
    "test:versioning": "node --test tests/node/versioning/*.test.mjs",
    "test:environment": "node --test tests/node/environment/*.test.mjs",
    "adr:new": "node .cursor/skills/wp-architecture-decision-records/scripts/new-adr.mjs",
    "adr:validate": "node .cursor/skills/wp-architecture-decision-records/scripts/validate-adr.mjs",
    "adr:status": "node .cursor/skills/wp-architecture-decision-records/scripts/set-adr-status.mjs",
    "adr:detect": "node .cursor/skills/wp-architecture-decision-records/scripts/detect-project.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@usebruno/cli": "4.0.0",
    "@wordpress/env": "11.12.0",
    "@wordpress/scripts": "34.0.0",
    "markdownlint-cli2": "0.23.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@wordpress/api-fetch": "7.0.0",
    "@wordpress/block-editor": "14.0.0",
    "@wordpress/blocks": "14.0.0",
    "@wordpress/components": "30.0.0",
    "@wordpress/element": "6.0.0",
    "@wordpress/i18n": "6.0.0",
    "@wordpress/icons": "11.0.0"
  }
}
