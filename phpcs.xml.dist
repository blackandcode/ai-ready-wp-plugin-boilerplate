<?xml version="1.0"?>
<ruleset name="PluginCodingStandards">
    <description>PHPCS ruleset for AI-Ready WP Plugin Boilerplate.</description>

    <!-- Paths to inspect -->
    <file>src/</file>
    <file>ai-ready-wp-plugin-boilerplate.php</file>
    <file>uninstall.php</file>

    <!-- Exclude vendor, build, and node artifacts -->
    <exclude-pattern>/vendor/</exclude-pattern>
    <exclude-pattern>/node_modules/</exclude-pattern>
    <exclude-pattern>/build/</exclude-pattern>
    <exclude-pattern>/tests/</exclude-pattern>

    <arg name="colors"/>
    <arg value="sp"/>
    <arg name="extensions" value="php"/>

    <!-- Enforce Core, Extra, and Docs rules -->
    <rule ref="WordPress-Core"/>
    <rule ref="WordPress-Extra"/>
    <rule ref="WordPress-Docs"/>

    <!-- Allow PSR-4 class filenames in modern src/ directory -->
    <rule ref="WordPress.Files.FileName">
        <exclude-pattern>src/*</exclude-pattern>
    </rule>

    <!-- Configuration parameters -->
    <config name="text_domain" value="ai-ready-wp-plugin-boilerplate"/>
    <config name="minimum_supported_wp_version" value="7.1"/>
</ruleset>
